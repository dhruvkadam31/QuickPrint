# Server Configuration
PORT=5000
PUBLIC_API_BASE_URL=http://localhost:5000
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/quickprint

# JWT Secret
JWT_SECRET=quickprint_super_secret_jwt_key_2026
ADMIN_PASSWORD_HASH=

# Firebase Admin: configure one credential source on the backend
FIREBASE_SERVICE_ACCOUNT_JSON=
# Or set GOOGLE_APPLICATION_CREDENTIALS to a service-account file path

# Razorpay Integration
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=placeholder_secret
PAYMENTS_MOCK_MODE=true

# Email Service (Nodemailer)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM="QuickPrint Notifications <no-reply@quickprint.com>"
