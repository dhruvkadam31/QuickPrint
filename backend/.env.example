# Server Configuration
PORT=5000
PUBLIC_API_BASE_URL=http://localhost:5000
FRONTEND_URL=http://localhost:5173
NODE_ENV=development

# MongoDB
MONGO_URI=

# JWT Secret
JWT_SECRET=
ADMIN_PASSWORD_HASH=

# Firebase Admin: configure one credential source on the backend
FIREBASE_SERVICE_ACCOUNT_JSON=
# Or set GOOGLE_APPLICATION_CREDENTIALS to a service-account file path

# Razorpay Integration
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
PAYMENTS_MOCK_MODE=true

# SMTP Email Service (Nodemailer)
# Works with Gmail (use 16-char App Password), Outlook, SendGrid, Amazon SES, or any custom SMTP
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password
EMAIL_FROM="QuickPrint Notifications <no-reply@quickprint.com>"

# Alternate SMTP_* naming is also supported:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password

